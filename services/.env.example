NODE_ENV = "development"
APP_NAME = "Node JS Microservice Boilerplate"
API_VER = "1.0.0"
LOG_DISABLE = "false"
LOG_LEVEL = "info"
# Public URL (for constructing image URLs)
BASE_URL = "http://localhost:8080"

USER_SERVICE_NAME ="user-service"
GATEWAY_SERVICE_NAME ="gateway"

USER_SERVICE_DB_DRIVER ="mysql"
USER_SERVICE_DB_HOST ='mysql-db'
USER_SERVICE_DB_PORT = 3306
USER_SERVICE_DB_NAME ="user-service"
USER_SERVICE_DB_USER_NAME ="######"
USER_SERVICE_DB_PASSWORD ="######"

MYSQL_ROOT_PASSWORD ="##########" # used by docker to initialize mysql

MAIL_HOST = "smtp.gmail.com"
MAIL_PORT = "587"
MAIL_USERNAME = ""#########""
MAIL_PASSWORD = ""#########""
MAIL_FROM = "Node JS Microservice Boilerplate <"#########">"
SUPPORT_MAIL = ""#########""

AWS_S3_BUCKET_NAME = "#########"
AWS_REGION = "#########"
AWS_ACCESS_KEY = "#########"
AWS_SECRET_ACCESS_KEY = "#########"

JWT_TOKEN_KEY = "#########"
CACHE_EXPIRATION = 3600 # 1 hour

CORS_ORIGINS = "http://127.0.0.1:8000,http://localhost:8000"

# SSL Configuration
SSL_STATUS = "false"
SSL_KEY_PEM_PATH = "/path/to/key.pem"
SSL_CERT_PEM_PATH = "/path/to/cert.pem"

RATE_LIMIT_POINTS = 10          # 10 requests
RATE_LIMIT_DURATION = 1         # per 1 second
RATE_LIMIT_BLOCK_DURATION = 0   # 0 = no block, just reject, 1 = block & reject